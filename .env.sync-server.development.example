# Copy this file to .env.sync-server.development.local and fill in local values.
DATABASE_URL=postgres://secscore:change-me@127.0.0.1:5432/secscore_sync
BIND_ADDR=127.0.0.1:8787
DEV_AUTH=true
# 可选：独立后端仓库路径；不设置时优先使用 ../SecScore-Sync-Server。
SYNC_SERVER_DIR=../SecScore-Sync-Server
# 已有后端运行时可设置 SYNC_SERVER_ONLY=true，仅让客户端使用 SYNC_SERVER_URL。
SYNC_SERVER_ONLY=false
SYNC_SERVER_URL=http://127.0.0.1:8787
STORAGE_ENABLED=true
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=secscore
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ALLOW_HTTP=true
S3_PATH_STYLE=true
STORAGE_MANAGEMENT_API_KEY=replace-with-local-management-key
STORAGE_PLATFORM_ID=local-secscore
SECTL_BASE_URL=https://appwrite.sectl.cn
SECTL_SERVICE_CLIENT_ID=
SECTL_SERVICE_CLIENT_SECRET=
