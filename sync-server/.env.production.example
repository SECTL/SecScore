# Copy to sync-server/.env.production and replace every placeholder before starting.
# Keep POSTGRES_PASSWORD URL-safe because it is also part of DATABASE_URL.
POSTGRES_DB=secscore
POSTGRES_USER=secscore
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

DATABASE_URL=postgres://secscore:replace-with-a-long-random-url-safe-password@postgres:5432/secscore
DEV_AUTH=false
SECTL_INTROSPECT_URL=https://appwrite.sectl.cn/api/oauth/introspect
SECTL_CLIENT_ID=replace-with-your-sectl-client-id
SECTL_PLATFORM_ID=replace-with-your-sectl-platform-id
RUST_LOG=info
